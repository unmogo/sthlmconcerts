# Browser app (Vite). This repo is Lovable-managed: the tracked .env already
# holds these browser-public values. Put local overrides in .env.local (ignored).
# Never put a real secret in .env or .env.local with a VITE_ prefix: it ships to the browser.

# Supabase project URL
VITE_SUPABASE_URL=
# Supabase publishable (anon) key
VITE_SUPABASE_PUBLISHABLE_KEY=
# Supabase project id; also in supabase/config.toml
VITE_SUPABASE_PROJECT_ID=

# Edge functions do NOT read this file. Set these as Supabase function secrets:
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY  provided by Supabase
# FIRECRAWL_API_KEY       page scraping (scrape-concerts, resolve-tickets, manage-concerts)
# LOVABLE_API_KEY         Lovable AI gateway (scraper extraction, venue resolution, images)
# SPOTIFY_CLIENT_ID       artist images in fetch-images (optional; skipped if unset)
# SPOTIFY_CLIENT_SECRET   same
